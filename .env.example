BOT_TOKEN=
# Chat that receives alerts. Only this chat and its members (in DMs) can use the bot.
# Group IDs are negative, e.g. -1001234567890
ADMIN_CHAT_ID=
MONGODB_URI=mongodb://mongo:27017/tikbot
TIKTOK_SIGN_API_KEY=
POLL_INTERVAL_MS=60000
TREASURE_BOX_ALERT_BEFORE_MS=60000
LOG_LEVEL=info

# Timezone for times shown in messages (default: server timezone, UTC in Docker).
# Uncomment and set it — an empty TZ= means UTC, not the machine's local time.
# TZ=Asia/Ho_Chi_Minh

# Device auto-claim — on only if DEVICE_ENABLED=true AND both tap positions are set
DEVICE_ENABLED=false
DEVICE_TYPE=adb
DEVICE_ID=
# First tap: the treasure box icon on the live screen
DEVICE_BOX_ICON_X=0
DEVICE_BOX_ICON_Y=0
# Second tap: the "Open" button in the treasure box popup
DEVICE_OPEN_BUTTON_X=0
DEVICE_OPEN_BUTTON_Y=0
DEVICE_OPEN_DELAY_MS=1000
DEVICE_PRE_CLAIM_MS=10000
DEVICE_NAV_DELAY_MS=3000
DEVICE_WDA_URL=http://localhost:8100
